<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.Migration.DependencyInjection</PackageId>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>Barbatos.Migration.DependencyInjection</RootNamespace>
    <CommonTags>$(CommonTags);dependency;injection;microsoft</CommonTags>
    <Description>Microsoft.Extensions.DependencyInjection integration for Barbatos.Migration. Registers the migration engine, its steps and its options in the service collection, and forwards the engine's log to ILogger.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Barbatos.Migration.Core\Barbatos.Migration.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
